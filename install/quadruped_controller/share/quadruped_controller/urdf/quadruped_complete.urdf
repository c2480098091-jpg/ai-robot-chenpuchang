<?xml version="1.0"?>
<robot name="quadruped">
  
  <!-- 材料定义 -->
  <material name="blue">
    <color rgba="0.2 0.5 0.8 1"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.2 0.2 1"/>
  </material>
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  
  <!-- 机身 -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.4 0.2 0.1"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>
  
  <!-- 前左腿 -->
  <link name="FL_leg">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.18"/>
      </geometry>
      <origin xyz="0 0 -0.09" rpy="1.57 0 0"/>
      <material name="red"/>
    </visual>
  </link>
  
  <joint name="FL_hip" type="revolute">
    <parent link="base_link"/>
    <child link="FL_leg"/>
    <origin xyz="0.15 0.1 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="100" velocity="10"/>
  </joint>
  
  <!-- 前右腿 -->
  <link name="FR_leg">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.18"/>
      </geometry>
      <origin xyz="0 0 -0.09" rpy="1.57 0 0"/>
      <material name="red"/>
    </visual>
  </link>
  
  <joint name="FR_hip" type="revolute">
    <parent link="base_link"/>
    <child link="FR_leg"/>
    <origin xyz="0.15 -0.1 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="100" velocity="10"/>
  </joint>
  
  <!-- 后左腿 -->
  <link name="RL_leg">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.18"/>
      </geometry>
      <origin xyz="0 0 -0.09" rpy="1.57 0 0"/>
      <material name="red"/>
    </visual>
  </link>
  
  <joint name="RL_hip" type="revolute">
    <parent link="base_link"/>
    <child link="RL_leg"/>
    <origin xyz="-0.15 0.1 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="100" velocity="10"/>
  </joint>
  
  <!-- 后右腿 -->
  <link name="RR_leg">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.18"/>
      </geometry>
      <origin xyz="0 0 -0.09" rpy="1.57 0 0"/>
      <material name="red"/>
    </visual>
  </link>
  
  <joint name="RR_hip" type="revolute">
    <parent link="base_link"/>
    <child link="RR_leg"/>
    <origin xyz="-0.15 -0.1 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="100" velocity="10"/>
  </joint>
  
</robot>
